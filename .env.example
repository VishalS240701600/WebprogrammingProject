# Copy to .env for local development (npm run dev loads it). Never commit .env.
# On Render, enter these in the dashboard instead (render.yaml already declares them).

# Port the server listens on (Render sets this itself)
PORT=3000

# "production" turns on secure cookies and makes SESSION_SECRET mandatory
NODE_ENV=development

# Long random string that signs session cookies, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# SQLite file location (default db/ridebuddy.db). Point at a persistent disk on Render if you add one.
# DB_PATH=/var/data/ridebuddy.db

# Identifies the app to Nominatim (address search); use your own contact info
NOMINATIM_USER_AGENT=RideBuddy/1.0 (your-email@example.com)
# Country bias for address search ('' to disable)
NOMINATIM_COUNTRY=in

# Only if the front end is hosted on a different domain (e.g. GitHub Pages). Leave unset on Render.
# FRONTEND_ORIGIN=https://yourname.github.io
